{
  "branches": ["master"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/exec", { "verifyReleaseCmd": "echo ${nextRelease.version} > .release-version" }],
    ["@semantic-release/github", {
      "assets": [
        { "path": "release-assets/*.apk", "label": "Droidtosh ${nextRelease.version} for Android (APK)" },
        { "path": "release-assets/*-mac.zip", "label": "Droidtosh ${nextRelease.version} for Mac" }
      ],
      "releaseNameTemplate": "Droidtosh <%= nextRelease.version %>",
      "successComment": false,
      "failComment": false,
      "releasedLabels": false
    }]
  ]
}
